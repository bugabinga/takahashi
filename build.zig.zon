// takahashi package manifest.
//
// taka has no Zig package dependencies: the window backend (SPEC 3.1) is the
// vendored sokol single-header C libraries under vendor/, and text is the
// vendored stb_truetype (no system text library). So the build fetches
// nothing — see docs/window-backend.md for the rationale.
.{
    .name = .takahashi,
    .version = "0.0.0",
    .fingerprint = 0xf83ba002c397a298,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "release.zig",
        "src",
        "vendor",
        "examples",
        "README.md",
        "SPEC.md",
    },
}
